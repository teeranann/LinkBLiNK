# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
build/
dist/
.venv/
venv/
env/
.conda/
.pytest_cache/
.ipynb_checkpoints/

# Pipeline outputs — regenerated on every run
outputs/*
!outputs/.gitkeep

# Large input data. Keep the demo folder tracked; ignore everything else.
data/input/*
!data/input/.gitkeep
!data/input/demo/
data/ground_truth/*
!data/ground_truth/.gitkeep

# Runtime output directories of the legacy v1.0.x pipeline
/temp_video_frames/
/unet_masks/
/filtered_masks/
/results/
/ground_truth/

# Raw videos and large binary inputs
*.seq

# Logs
*.log
runs/

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# Never commit credentials
*secret*
*credential*
*.key
